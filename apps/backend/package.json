{
  "name": "@bfam/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:phase1": "ts-node-dev --exit-child --transpile-only src/seed/phase1Seed.ts",
    "db:seed:cricketers": "ts-node-dev --exit-child --transpile-only src/seed/cricketersSeed.ts",
    "seed": "npm run db:seed:phase1",
    "db:seed": "npm run db:seed:phase1",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@bfam/shared-types": "*",
    "@sentry/node": "^8.26.0",
    "apple-signin-auth": "^2.1.0",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.6",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "umzug": "^3.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
