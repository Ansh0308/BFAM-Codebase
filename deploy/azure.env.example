# The backend's settings on the VM — copy to /opt/bfam/backend.env and fill in.
# NODE_ENV, PORT, TZ, TRUST_PROXY and REDIS_URL are set by docker-compose.azure.yml.
# NEVER commit the filled-in file.

# ---- Database: Azure Database for MySQL Flexible Server ----
DB_HOST=<server-name>.mysql.database.azure.com
DB_PORT=3306
DB_NAME=bfam
DB_USER=bfamadmin
DB_PASSWORD=
# Azure requires TLS; its certificate chains to a public CA, so no CA file is needed.
DB_SSL=true

# ---- Security ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The web/admin origins allowed to call the API (comma-separated, no trailing slash).
# Mobile apps are not affected by CORS.
CORS_ORIGIN=https://<your-mobile-web>.pages.dev,https://<your-admin>.pages.dev

# ---- Sign-up OTP ----
# BETA: static code, no SMS. Remove OTP_MODE and set the MSG91_* values to switch
# to real delivery — see "Replacing the static OTP" in BFAM_Deployment_Plan.md.
OTP_MODE=static
STATIC_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# ---- File storage: Cloudflare R2 (S3-compatible) ----
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bfam-public
AWS_S3_PRIVATE_BUCKET=bfam-private
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://pub-<id>.r2.dev

# ---- Optional integrations (leave blank to disable) ----
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
RAPIDAPI_KEY=
