{
  "expo": {
    "name": "BFAM Mobile",
    "slug": "bfam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "bfam",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bfam.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BFAM uses your location to show turfs near you in Discover."
      }
    },
    "android": {
      "package": "com.bfam.mobile",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "bfam-sports",
          "project": "bfam-mobile"
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BFAM uses your location to show turfs near you in Discover."
        }
      ]
    ]
  }
}
