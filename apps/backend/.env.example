# BFAM Backend Configuration Example
# Copy the matching section to .env for local setup.
# NEVER commit real secrets to source control.

# Development
PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bfam_dev
DB_USER=bfam_user
DB_PASSWORD=bfam_password
REDIS_URL=redis://127.0.0.1:6379
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
CRICKET_API_KEY=

# Cricketer search (favorite-cricketer picker) — RapidAPI "cricket-api-free-data".
# Takes priority over CRICKET_API_KEY when both are set.
RAPIDAPI_KEY=
RAPIDAPI_HOST=cricket-api-free-data.p.rapidapi.com

# Email verification (Brevo SMTP relay) — profile email add/verify flow.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Must be a sender verified in the Brevo account.
BREVO_SENDER_EMAIL=

# JWT_SECRET is REQUIRED in production (the server refuses to boot without
# one) — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS_ORIGIN: comma-separated allowlist, e.g. https://app.bfam.com. Unset =
# allow all origins, which is fine for local dev only.
CORS_ORIGIN=

# MSG91 (OTP SMS delivery) — see the setup walkthrough for how to get these.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# AWS S3 (profile photo uploads) — see the S3 setup walkthrough.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Staging
STAGING_PORT=5000
STAGING_NODE_ENV=staging
STAGING_DB_HOST=
STAGING_DB_PORT=3306
STAGING_DB_NAME=bfam_staging
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_REDIS_URL=
STAGING_SENTRY_DSN=
STAGING_RAZORPAY_KEY_ID=
STAGING_RAZORPAY_KEY_SECRET=
STAGING_RAZORPAY_WEBHOOK_SECRET=
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_ID_IOS=
STAGING_GOOGLE_CLIENT_ID_ANDROID=
STAGING_APPLE_CLIENT_ID=
STAGING_APPLE_TEAM_ID=
STAGING_APPLE_KEY_ID=
STAGING_CRICKET_API_KEY=
STAGING_JWT_SECRET=
STAGING_CORS_ORIGIN=
STAGING_MSG91_AUTH_KEY=
STAGING_MSG91_FLOW_ID=
STAGING_MSG91_SENDER_ID=
STAGING_AWS_REGION=
STAGING_AWS_ACCESS_KEY_ID=
STAGING_AWS_SECRET_ACCESS_KEY=
STAGING_AWS_S3_BUCKET=

# Production
PROD_PORT=5000
PROD_NODE_ENV=production
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=bfam_prod
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_REDIS_URL=
PROD_SENTRY_DSN=
PROD_RAZORPAY_KEY_ID=
PROD_RAZORPAY_KEY_SECRET=
PROD_RAZORPAY_WEBHOOK_SECRET=
PROD_GOOGLE_CLIENT_ID=
PROD_GOOGLE_CLIENT_ID_IOS=
PROD_GOOGLE_CLIENT_ID_ANDROID=
PROD_APPLE_CLIENT_ID=
PROD_APPLE_TEAM_ID=
PROD_APPLE_KEY_ID=
PROD_CRICKET_API_KEY=
PROD_JWT_SECRET=
PROD_CORS_ORIGIN=
PROD_MSG91_AUTH_KEY=
PROD_MSG91_FLOW_ID=
PROD_MSG91_SENDER_ID=
PROD_AWS_REGION=
PROD_AWS_ACCESS_KEY_ID=
PROD_AWS_SECRET_ACCESS_KEY=
PROD_AWS_S3_BUCKET=
