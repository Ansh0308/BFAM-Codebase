# BFAM Mobile Client Environment Variables
# Copy the matching section to .env for local setup. DO NOT commit secrets to git.

# Development
# `localhost` only works for the web/mobile-web preview (same machine as the
# backend). Testing with Expo Go on a physical phone requires your dev
# machine's LAN IP instead (e.g. http://192.168.1.8:5000) — the phone can't
# resolve "localhost" to your PC. Find it with `ipconfig` (Windows) or
# `ifconfig`/`ip addr` (macOS/Linux); phone and PC must be on the same WiFi.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_SENTRY_DSN=
# expo-auth-session's Google provider needs a client id per platform it can
# run on. Only the audience actually matters server-side (see
# GOOGLE_CLIENT_ID / _IOS / _ANDROID in apps/backend/.env.example) — these
# must match those.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
# expo-apple-authentication needs no client id client-side (it uses the
# app's own bundle identifier / entitlement) — nothing to add here.

# Staging
EXPO_PUBLIC_STAGING_API_URL=
EXPO_PUBLIC_STAGING_SENTRY_DSN=
EXPO_PUBLIC_STAGING_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_STAGING_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_STAGING_GOOGLE_CLIENT_ID_ANDROID=

# Production
EXPO_PUBLIC_PROD_API_URL=
EXPO_PUBLIC_PROD_SENTRY_DSN=
EXPO_PUBLIC_PROD_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_PROD_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_PROD_GOOGLE_CLIENT_ID_ANDROID=
