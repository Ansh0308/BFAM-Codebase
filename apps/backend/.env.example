# BFAM Backend Configuration Example
# Copy the matching section to .env for local setup.
# NEVER commit real secrets to source control.

# Development
PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bfam_dev
DB_USER=bfam_user
DB_PASSWORD=bfam_password
REDIS_URL=redis://127.0.0.1:6379
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
CRICKET_API_KEY=

# Cricketer search (favorite-cricketer picker) — RapidAPI "cricket-api-free-data".
# Takes priority over CRICKET_API_KEY when both are set.
RAPIDAPI_KEY=
RAPIDAPI_HOST=cricket-api-free-data.p.rapidapi.com

# Email verification (Brevo SMTP relay) — profile email add/verify flow.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Must be a sender verified in the Brevo account.
BREVO_SENDER_EMAIL=

# JWT_SECRET is REQUIRED in production (the server refuses to boot without
# one) — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS_ORIGIN: comma-separated allowlist, e.g. https://app.bfam.com. Unset =
# allow all origins, which is fine for local dev only.
CORS_ORIGIN=

# MSG91 (OTP SMS delivery) — see the setup walkthrough for how to get these.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# File storage: AWS S3 or any S3-compatible store (Cloudflare R2 recommended for beta).
#   AWS_S3_BUCKET          bucket for PUBLIC files (profile photos)
#   AWS_S3_PRIVATE_BUCKET  bucket for PRIVATE files (staff ID documents); keep it NON-public
#   AWS_REGION             "auto" for Cloudflare R2
#   S3_ENDPOINT            only for non-AWS stores, e.g. https://<account>.r2.cloudflarestorage.com
#   S3_PUBLIC_BASE_URL     where public files are served from (required with S3_ENDPOINT),
#                          e.g. https://pub-xxxx.r2.dev or a custom domain
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRIVATE_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ---- Deployment settings (see BFAM_Deployment_Plan.md) ----

# Behind a reverse proxy (Caddy, Azure/Railway load balancer) set this to the
# number of proxies so rate limits see each user's real IP. Leave blank when
# nothing sits in front of the server (trusting the header then lets clients
# spoof their IP).
TRUST_PROXY=

# TLS to the database — REQUIRED by managed MySQL such as Azure Database for
# MySQL. DB_SSL_CA / DB_SSL_CA_BASE64 only if the provider uses a private CA;
# DB_SSL_REJECT_UNAUTHORIZED=false only for a self-signed provider cert.
DB_SSL=
DB_SSL_CA=
DB_SSL_CA_BASE64=
DB_SSL_REJECT_UNAUTHORIZED=

# BETA ONLY: OTP_MODE=static makes every OTP the fixed STATIC_OTP_CODE and sends
# no SMS/email. Anyone who knows the code can verify any phone / reset any
# password — invite-only beta only. Leave blank for real delivery (MSG91 below).
# See "Replacing the static OTP" in BFAM_Deployment_Plan.md.
OTP_MODE=
STATIC_OTP_CODE=123456

# Booking times are India wall-clock; the code handles this explicitly, but a
# server that also runs date-formatting tools should use TZ=Asia/Kolkata.
# NODE_ENV must be "production" on a real deployment (an unset or unknown value
# is treated as non-local and requires JWT_SECRET; /auth/dev-token is 404).

# Staging
STAGING_PORT=5000
STAGING_NODE_ENV=staging
STAGING_DB_HOST=
STAGING_DB_PORT=3306
STAGING_DB_NAME=bfam_staging
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_REDIS_URL=
STAGING_SENTRY_DSN=
STAGING_RAZORPAY_KEY_ID=
STAGING_RAZORPAY_KEY_SECRET=
STAGING_RAZORPAY_WEBHOOK_SECRET=
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_ID_IOS=
STAGING_GOOGLE_CLIENT_ID_ANDROID=
STAGING_APPLE_CLIENT_ID=
STAGING_APPLE_TEAM_ID=
STAGING_APPLE_KEY_ID=
STAGING_CRICKET_API_KEY=
STAGING_JWT_SECRET=
STAGING_CORS_ORIGIN=
STAGING_MSG91_AUTH_KEY=
STAGING_MSG91_FLOW_ID=
STAGING_MSG91_SENDER_ID=
STAGING_AWS_REGION=
STAGING_AWS_ACCESS_KEY_ID=
STAGING_AWS_SECRET_ACCESS_KEY=
STAGING_AWS_S3_BUCKET=

# Production
PROD_PORT=5000
PROD_NODE_ENV=production
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=bfam_prod
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_REDIS_URL=
PROD_SENTRY_DSN=
PROD_RAZORPAY_KEY_ID=
PROD_RAZORPAY_KEY_SECRET=
PROD_RAZORPAY_WEBHOOK_SECRET=
PROD_GOOGLE_CLIENT_ID=
PROD_GOOGLE_CLIENT_ID_IOS=
PROD_GOOGLE_CLIENT_ID_ANDROID=
PROD_APPLE_CLIENT_ID=
PROD_APPLE_TEAM_ID=
PROD_APPLE_KEY_ID=
PROD_CRICKET_API_KEY=
PROD_JWT_SECRET=
PROD_CORS_ORIGIN=
PROD_MSG91_AUTH_KEY=
PROD_MSG91_FLOW_ID=
PROD_MSG91_SENDER_ID=
PROD_AWS_REGION=
PROD_AWS_ACCESS_KEY_ID=
PROD_AWS_SECRET_ACCESS_KEY=
PROD_AWS_S3_BUCKET=
